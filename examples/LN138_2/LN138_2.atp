MODEL Yaluk1
 -- This model is link with ATP by means of a iluminated line characteristic method
 -- It must have four inputs for one single line (Va,Ia,Vb,Ib)
CONST
cond {VAL:1} --num. phases
INPUT
  Va[1..cond]
  Vb[1..cond]
VAR Vfa[1..cond],Vfb[1..cond]
OUTPUT
   Vfa,Vfb
DATA
	No_Lin
MODEL yaluk_f FOREIGN YALUK_DLL_MODEL {ixdata:4, ixin:3, ixout:2, ixvar:200}
EXEC -- using the DLL subroutine
  USE yaluk_f AS yaluk_f
    DATA xdata[1..4]:=[timestep,stoptime,cond,No_Lin]
    INPUT xin[1..2*cond+1]:=[t,Va[1..cond],Vb[1..cond]]
  --    HISTORY histdef(xvar[1]):=0
    OUTPUT 	Vfa[1..cond]:=xout[1..cond]
		Vfb[1..cond]:=xout[cond+1..2*cond]
  ENDUSE
  ENDEXEC
ENDMODEL
